{
  "name": "nspace",
  "version": "0.7.1",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "payment-intent-service",
    "payout-service",
    "analytics-service"
  ],
  "overrides": {
    "@nimiq/core": "2.20.0"
  },
  "scripts": {
    "prepare-merge": "node scripts/prepare-merge.cjs",
    "check-vercel-rewrites": "node scripts/check-vercel-rewrites.cjs",
    "dev": "node scripts/ensure-payout-dev-env.cjs && concurrently -n client,server,payout,analytics -c blue,green,magenta,cyan \"npm run dev -w client\" \"npm run dev -w server\" \"npm run dev -w payout-service\" \"npm run dev -w analytics-service\"",
    "dev:game": "concurrently -n client,server -c blue,green \"npm run dev -w client\" \"npm run dev -w server\"",
    "build": "npm run build -w client && npm run build -w server",
    "start": "npm run start -w server",
    "dev:payment-intent": "npm run dev -w payment-intent-service",
    "dev:payout": "npm run dev -w payout-service",
    "dev:analytics": "npm run dev -w analytics-service",
    "test": "npm test -w payment-intent-service && npm test -w payout-service && npm test -w analytics-service && npm test -w server",
    "tutorial:reseed-bootstrap": "node scripts/reseed-tutorial-bootstrap.cjs",
    "tutorial:reseed-bootstrap:local": "node scripts/reseed-tutorial-bootstrap-local.cjs",
    "postinstall": "node scripts/postinstall.cjs"
  },
  "devDependencies": {
    "concurrently": "^9.1.2",
    "patch-package": "^8.0.1"
  },
  "description": "**Nimiq Space** is a browser multiplayer hangout for the [Nimiq](https://nimiq.com) community: walk an isometric grid with other players, chat, build with blocks, use portals between rooms, and (in the canvas room) claim tiles on a shared leaderboard. You sign in with a **Nimiq wallet** (or a local **dev login** on your machine only).",
