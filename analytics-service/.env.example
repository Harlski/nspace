# Analytics Service — Event Log scans for /analytics overview and daily-stats.
# Shared Bearer secret with the game server (ANALYTICS_SERVICE_API_SECRET).

PORT=3092
HOST=127.0.0.1
ANALYTICS_SERVICE_API_SECRET=dev-insecure-local-analytics-secret
# Default: ../../server/data/events relative to this package.
# EVENT_LOG_DIR=../server/data/events
# ANALYTICS_OVERVIEW_CACHE_TTL_MS=120000
# ANALYTICS_FIRST_TIME_LOOKBACK_DAYS=400
