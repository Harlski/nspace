# Client Vite env — copy to `.env.development` for local `npm run dev`
# (gitignored). Restart Vite after changes.

# Show the Main Menu "Dev login" button. Must match server DEV_AUTH_BYPASS=1.
VITE_DEV_AUTH_BYPASS=1

# Optional: Admin overlay chrome (layout / fog / camera). Wallet still needs admin allowlist for Watch.
# VITE_ADMIN_ENABLED=true

# Nimiq Hub for browser wallet sign-in (default production Hub).
# VITE_HUB_URL=https://hub.nimiq.com

# Leave empty for local Vite: /api and WS proxy to the game server on :3001.
# Only set when the SPA and API are on different origins (split hosting).
# VITE_API_BASE_URL=
# VITE_WS_BASE_URL=

# --- QR Pay login (phone / LAN) ---
# The QR encodes an HTTPS/HTTP SPA URL from the *server* PUBLIC_BASE_URL (see server/.env).
# Phone and desktop must reach that origin. Vite already binds host: true on :5173.
# No extra VITE_* keys are required for QR login itself.
